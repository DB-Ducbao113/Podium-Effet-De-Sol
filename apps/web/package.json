{
  "name": "@peds/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "qa:model-b:source-only": "node scripts/verify-model-b-source-only.mjs",
    "test:coverage": "vitest run --coverage",
    "build": "tsc --noEmit && vite build && node scripts/generate-seo-artifacts.mjs && node scripts/prerender-engineering.mjs && node scripts/prune-legacy-showroom-assets.mjs && node scripts/check-commercial-visual-isolation.mjs && node scripts/verify-cloudflare-build.mjs",
    "qa:model-b:frame-audit": "node --test scripts/model-b-frame-audit.test.mjs",
    "qa:model-b:cad-assembly": "node scripts/verify-model-b-cad-assembly.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "animejs": "^4.5.0",
    "meshoptimizer": "0.18.1"
  }
}
