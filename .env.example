# Comma-separated browser origins allowed to call Cloudflare Worker API routes.
# Same-origin requests are allowed without listing the production hostname.
ALLOWED_ORIGINS=https://example.com

# Optional absolute local path used by the development-only Model B route.
# The frozen source is local under source-assets; never expose this path as VITE_*.
PEDS_MODEL_B_PATH=C:/absolute/local/path/model-b-eds-optimized-v1.glb

# P5 visual review is shown by default in DEV when its local images are present.
# Set to 0 to hide the review; production never serves these local images.
# VITE_P5_LOCAL_REVIEW=0
