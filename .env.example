# Comma-separated extra browser origins allowed to call Cloudflare Worker API routes.
# Same-origin requests are always allowed without listing the production hostname.
# Leave empty in production for strict same-origin-only API access.
ALLOWED_ORIGINS=

# Production canonical site origin (used by SEO sitemap/robots/prerender build scripts).
# Example: https://podium-eds.example.com
VITE_SITE_URL=

# Set to "true" together with VITE_SITE_URL on a live custom-domain production build
# to enable search-engine indexing (robots.txt Allow: / and index, follow meta).
# Leave unset or "false" for preview/staging/workers.dev builds.
VITE_ALLOW_INDEXING=false

# Optional deployment context ("production" | "preview"). Preview contexts always force noindex.
VITE_DEPLOYMENT_CONTEXT=production
