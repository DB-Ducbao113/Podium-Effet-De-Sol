{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "podium-effet-de-sol-local",
  "main": "./apps/api/src/worker.ts",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["no_nodejs_compat"],
  "upload_source_maps": false,
  "assets": {
    "directory": "./apps/web/dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/models/*"],
  },
  "vars": {
    "APP_ENV": "development",
    "ALLOWED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173,http://localhost:8787,http://127.0.0.1:8787",
  },
  "env": {
    "production": {
      "name": "podium-effet-de-sol-production",
      "vars": {
        "APP_ENV": "production",
        "ALLOWED_ORIGINS": "",
      },
    },
  },
}
